<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.asagao.Mapper.OrderDetailMapper">
	<resultMap type="com.asagao.Domain.OrderDetail"
		id="OrderDetail">
		<id column="id" property="id" />
		<result column="orders_id" property="orderId" />
		<result column="productId" property="productId" />
		<result column="amount" property="amount" />
		<result column="created_at" property="createdAt" />
		<result column="updated_at" property="updatedAt" />
		<result column="name" property="productName"/>
		<result column="description" property="productDescription"/>
		<result column="price" property="productPrice"/>
		<result column="image_url" property="productImage_url"/>
	</resultMap>
	<insert id="create" useGeneratedKeys="true" keyProperty="id">
		INSERT INTO
		ORDERS_DETAIL(ORDERS_ID,PRODUCT_ID,AMOUNT,CREATED_AT,UPDATED_AT)
		VALUES
		(#{orderId},#{productId},#{amount},#{createdAt},#{updatedAt})
	</insert>
	<select id="getOderDetails" resultMap="OrderDetail">
		select ORDERS_DETAIL.id ,
		ORDERS_DETAIL.orders_id ,
		ORDERS_DETAIL.product_id,
		ORDERS_DETAIL.amount,
		ORDERS_DETAIL.created_at,
		ORDERS_DETAIL.updated_at,
		product.price,
		product.name,
		product.description,
		product.image_url
		from ORDERS_DETAIL inner join product on ORDERS_DETAIL.product_id =
		product.id
		where orders_id =#{orderId}
	</select>
</mapper>