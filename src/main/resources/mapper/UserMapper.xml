<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
  
  <mapper namespace="com.asagao.Mapper.UserMapper">
  
  <resultMap id="User" type="com.asagao.Domain.User">
  	<id column="id" property="id"/>
  	<result column="email" property="email"/>
  	<result column="password" property="password"/>
  	<result column="role" property="role"/>
  	<result column="last_name" property="lastName"/>
  	<result column="first_name" property="firstName"/>
  	<result column="post_number" property="postNumber"/>
  	<result column="address" property="address"/>
  	<result column="tel_number" property="telNumber"/>
  	<result column="created_at" property="createdAt"/>
  	<result column="updated_at" property="updatedAt"/>
  </resultMap>
  
  <select id="findByEmailAndPassword" resultMap="User">
  	SELECT
  	  *
  	From
  	  user
  	WHERE
  	  email = #{email}
  	And
  	  password = #{password}      
  </select>
  
  <insert id="save" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO user (email, password, role, last_name, first_name, post_number, address, tel_number, created_at, updated_at)
    values (#{email}, #{password}, #{role}, #{lastName}, #{firstName}, #{postNumber}, #{address}, #{telNumber}, #{createdAt}, #{updatedAt})
  </insert>
  
  </mapper>