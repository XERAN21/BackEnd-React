<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
  
<mapper namespace="com.asagao.Mapper.NoticeMapper">
	<resultMap type="com.asagao.Domain.Notice" id="Notice">
		<id property="Id" column="id"/>
		<result property="title" column="title"/>
		<result property="body" column="body"/>
		<result property="visibilityFlag" column="visibility_flag"/>
		<result property="deleteFlg" column="delete_flg"/>
		<result property="createdAt" column="created_at"/>
		<result property="updatedAt" column="updated_at"/>
	</resultMap>
	<select id="findAll" resultMap="Notice">
		SELECT * FROM NOTICE
	</select>
	<select id="findById" resultMap="Notice">
		SELECT * FROM NOTICE 
		WHERE id = #{Id}
	</select>

	<insert id="create"  useGeneratedKeys="true" keyProperty="id">
		INSERT INTO 
		NOTICE(TITLE,BODY,VISIBILITY_FLAG,DELETE_FLG,CREATED_AT,UPDATED_AT)
		VALUES
		(#{title},#{body},#{visibilityFlag},#{deleteFlg},#{createdAt},#{updatedAt})
	</insert>
	
	<update id="update" parameterType="com.asagao.Domain.Notice">
	 	UPDATE notice
	 	SET
	 	  title = #{title},
	 	  body = #{body}
	 	WHERE
	 	  id = #{id}  
	</update>
</mapper>