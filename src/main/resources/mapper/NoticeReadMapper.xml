<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
  
<mapper namespace="com.asagao.Mapper.NoticeReadMapper">
	<resultMap type="com.asagao.Domain.NoticeRead" id="NoticeRead">
		<id property="Id" column="Id"/>
		<result property="NoticeId" column="notice_id"/>
		<result property="UserId" column="user_id"/>
		<result property="createdAt" column="created_at"/>
		<result property="updatedAt" column="updated_at"/>
	</resultMap>
	<select id="getAll" resultMap="NoticeRead">
		select * from notice_read 
		where user_id = #{userId}
	</select>
	<insert id="MarkRead" useGeneratedKeys="true" keyProperty="Id">
		insert into 
		notice_read  (notice_id,user_id,created_at,updated_at)
		values
		(#{NoticeId},#{UserId},#{createdAt},#{updatedAt})
	</insert>
</mapper>